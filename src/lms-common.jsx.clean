      letter-spacing: 0.5px;
    }
    .standing-text {
      font-size: 7.5pt;
      line-height: 1.4;
      color: #334155;
      margin: 0;
    }

    p {
      margin: 0 0 6px;
      font-size: 8pt;
      line-height: 1.4;
      color: #334155;
      text-align: justify;
    }

    .clause {
      margin-bottom: 5px;
      font-size: 8pt;
      line-height: 1.38;
      color: #334155;
      text-align: justify;
    }
    .clause b {
