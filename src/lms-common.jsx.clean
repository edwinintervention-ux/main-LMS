// ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
//  PDF GENERATORS ΓÇö Loan Agreement + Asset Declaration
// ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ

// ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
//  PDF DOCUMENT GENERATORS
// ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ

const safeStr = (v) =>
  String(v || "").replace(
    /[<>&"]/g,
    (c) => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;" })[c],
  );

/**
 * Recolors every dark/ink pixel in a signature data-URL to royal blue (#002B99).
 * Returns a Promise<string> (a new PNG data-URL with blue ink).
 * Falls back to the original URL on error.
 */
const recolorSigBlue = (dataUrl) => {
  if (!dataUrl || typeof document === 'undefined') return Promise.resolve(dataUrl || '');
  return new Promise((resolve) => {
    const img = new Image();
    img.crossOrigin = 'Anonymous';
    img.onload = () => {
      try {
        const w = img.naturalWidth  || 500;
        const h = img.naturalHeight || 200;
        const canvas = document.createElement('canvas');
        canvas.width  = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0);
        const imageData = ctx.getImageData(0, 0, w, h);
        const d = imageData.data;
        for (let i = 0; i < d.length; i += 4) {
          // Any non-white visible pixel ΓåÆ royal blue #002B99
          if (d[i + 3] > 10 && (d[i] < 230 || d[i + 1] < 230 || d[i + 2] < 230)) {
            d[i]     = 0;    // R
            d[i + 1] = 0;    // G 
            d[i + 2] = 255;  // B (pure bright blue)
            // If the pixel was anti-aliased (semi-transparent grey), 
            // make it more solid so the bright blue pops better against white,
            // avoiding muddy grey-blue edges.
            if (d[i+3] > 10 && d[i+3] < 255) {
                d[i+3] = Math.min(255, d[i+3] + 50); 
            }
          }
        }
        ctx.putImageData(imageData, 0, 0);
        resolve(canvas.toDataURL('image/png'));
      } catch (e) {
        console.error('recolorSigBlue canvas error:', e);
        resolve(dataUrl);
      }
    };
    img.onerror = (e) => {
      console.error('recolorSigBlue load error:', e);
      resolve(dataUrl);
    };
    img.src = dataUrl;
  });
};

/**
 * Pre-processes a loan object's signatures to blue ink before PDF generation.
 * Await this before calling generateLoanAgreementHTML / generateAssetListHTML.
 * Returns a shallow copy of the loan with recolored signature data-URLs.
 */
export const prepareSignatures = async (loan) => {
  if (!loan) return loan;
  const [bs, os] = await Promise.all([
    recolorSigBlue(loan.borrower_signature),
    recolorSigBlue(loan.officer_signature),
  ]);
  return { ...loan, borrower_signature: bs, officer_signature: os };
};

export const generateLoanAgreementHTML = (loan = {}, customer = {}, officer = '', format = 'html') => {
  const today = new Date().toLocaleDateString("en-KE", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });

  const rawDisb = loan?.disbursed || loan?.disbursed_at || loan?.disbursedAt;
  const disbDate = safeStr(
    rawDisb
      ? new Date(rawDisb).toLocaleDateString("en-KE", {
          day: "2-digit",
          month: "long",
          year: "numeric",
        })
      : today,
  );

  const product = loan?.product || 'Swift30';
  const isSwift15 = product === 'Swift15';
  const isFlex60 = (product === 'Flex60' || product === 'Flex 60');
  const isFlexSure = product === 'FlexSure';
  const loanDays = getProductDays(product);
  const dueDateObj = rawDisb ? new Date(rawDisb) : new Date();
  dueDateObj.setDate(dueDateObj.getDate() + loanDays);
  const dueDateFormatted = dueDateObj.toLocaleDateString("en-KE", { day: "2-digit", month: "long", year: "numeric" });
  const discount = Number(loan?.interestDiscount || 0);
  const baseRate = getProductBaseRate(product);
  const effRate = baseRate * (1 - discount / 100);
  const principal = Number(loan?.amount || 0);
  const interestAmt = Math.round(principal * effRate);
  const totalRepay = principal + interestAmt;

  const basePctLabel = `${(baseRate * 100).toFixed(0)}%`;
  const interestPercentLabel = discount > 0
    ? `${(effRate * 100).toFixed(1)}% Discounted`
    : `${basePctLabel} Flat`;

  const interestRateText = discount > 0
    ? `${(effRate * 100).toFixed(1)}% flat (discounted from ${basePctLabel})`
    : `${basePctLabel} flat`;

  const fmtAmt = (v) => "KES " + Number(v || 0).toLocaleString("en-KE");
  const n = (v) => (v === undefined || v === null || v === "" ? "ΓÇö" : safeStr(v));

  const repSched = () => {
    const t = totalRepay;
    const rt = loan?.repaymentType || "Monthly";
    const weekCount = Math.round(loanDays / 7);
    const biweekCount = Math.round(loanDays / 14);
    if (rt === "Daily") return fmtAmt(Math.ceil(t / loanDays)) + ` per day for ${loanDays} days`;
    if (rt === "Weekly") return fmtAmt(Math.ceil(t / weekCount)) + ` per week for ${weekCount} weeks`;
    if (rt === "Biweekly" || rt === "Bi-weekly") return fmtAmt(Math.ceil(t / biweekCount)) + " every 2 weeks";
    if (rt === "Monthly") return fmtAmt(t) + " per month";
    return fmtAmt(t) + " lump sum";
  };

  const stampDateStr = (() => {
    const _d = disbDate || today;
    const _p = _d.split(" ");
    return _p[0] + " " + (_p[1] || "").slice(0, 3).toUpperCase() + " " + (_p[2] || "");
  })();

  const borrowerName = n(customer?.name || loan?.customer);
  const nationalId = n(customer?.idNo || customer?.id_number || customer?.idNumber || loan?.idNo || loan?.id_number);
  const phoneNo = n(customer?.phone);
  const residence = n(customer?.residence || customer?.location);
  const businessName = n(customer?.business || customer?.business_name);
  const businessType = n(customer?.businessType || customer?.business_type);
  const businessLocation = n(customer?.location);
  const customerId = n(customer?.id);
  const officerName = n(loan?.officer || officer || "Donald Barare");
  const loanId = n(loan?.id);

  const refereeRows = () => {
    const refs = [];
    if (customer?.n1n) refs.push({ n: 1, name: customer.n1n, phone: customer.n1p, rel: customer.n1r });
    if (customer?.n2n) refs.push({ n: 2, name: customer.n2n, phone: customer.n2p, rel: customer.n2r });
    if (customer?.n3n) refs.push({ n: 3, name: customer.n3n, phone: customer.n3p, rel: customer.n3r });
    if (refs.length === 0) {
      return `<tr><td>1</td><td>ΓÇö</td><td>ΓÇö</td><td>ΓÇö</td></tr>`;
    }
    return refs
      .map(
        (r) =>
          `<tr><td>${r.n}</td><td>${n(r.name)}</td><td>${n(r.phone)}</td><td>${n(r.rel || "Referee / Next of Kin")}</td></tr>`,
      )
      .join("");
  };

  const qrUrl = "https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=" + encodeURIComponent(`https://adequatecapital.co.ke/pay?account=${nationalId}`);
  const renderHeader = () => `
    <div class="doc-header">
      <div style="display: flex; align-items: center; gap: 10px;">
        <img src="${ADEQUATE_LOGO_BASE64}" alt="Adequate Capital Logo" style="height: 32px; width: auto;" />
        <div style="display: flex; flex-direction: column;">
          <span class="header-co">ADEQUATE CAPITAL LTD</span>
          <span style="color: #00D4AA; font-size: 6.5pt; font-weight: 600; font-style: italic; margin-top: 2px;">You deserve nothing less</span>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 12px;">
        <span class="header-ref" style="display: flex; align-items: center; gap: 10px;">
          <span>Loan Facility Agreement &middot; ${loanId}</span>
          <img src="${qrUrl}" alt="Payment QR Code" style="width: 36px; height: 36px; border-radius: 4px; padding: 2px; border: 1px solid #CBD5E1;" />
        </span>
      </div>
    </div>
  `;

  const renderFooter = (pageNo) => `
    <div class="doc-footer">
      <span>Adequate Capital Ltd &middot; P.O. Box 253-00241, Kitengela &middot; info@adequatecapital.co.ke &middot; Paybill 4166191 &middot; T: 0727 625 470 / 0714 256 816</span>
      <span class="page-num">Page ${pageNo} of 11</span>
    </div>
  `;

  return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Loan Agreement - ${loanId}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    
    * { box-sizing: border-box; }
    
    body { 
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
      font-size: 8.5pt; 
      line-height: 1.45; 
      color: #0F172A; 
      margin: 0; 
      padding: 0;
      background: #E2E8F0;
    }
    
    .doc-page { 
      width: 100%;
      max-width: 800px;
      min-height: 1130px;
      margin: 20px auto;
      padding: 35px 45px 25px 45px;
      background: #ffffff;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      page-break-after: always;
      break-after: page;
      box-sizing: border-box;
      position: relative;
    }
    .doc-page:last-of-type {
      page-break-after: avoid;
      break-after: avoid;
      margin-bottom: 20px;
    }

    .doc-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #00D4AA;
      padding-bottom: 5px;
      margin-bottom: 14px;
      font-size: 7.5pt;
      font-weight: 600;
      color: #64748B;
    }
    .doc-header .header-co {
      font-weight: 800;
      color: #0F172A;
      letter-spacing: 0.5px;
    }
    .doc-header .header-ref {
      color: #64748B;
    }

    .doc-footer {
      border-top: 1px solid #E2E8F0;
      padding-top: 6px;
      margin-top: 14px;
      font-size: 7pt;
      color: #94A3B8;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .doc-footer .page-num {
      font-weight: 600;
      white-space: nowrap;
      margin-left: 10px;
    }

    .doc-content {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    h1.doc-main-title {
      font-size: 15pt;
      font-weight: 800;
      color: #1E293B;
      text-align: center;
      margin: 6px 0 3px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    img.doc-logo {
      display: block;
      margin: 6px auto 2px;
      height: 64px;
      object-fit: contain;
    }
    .doc-subtitle {
      font-size: 8.5pt;
      color: #64748B;
