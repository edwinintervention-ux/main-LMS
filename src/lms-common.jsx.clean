    .clause-sub {
      margin-left: 16px;
      margin-bottom: 4px;
      font-size: 8pt;
      line-height: 1.38;
      color: #334155;
      text-align: justify;
    }

    table.doc-table {
      width: 100%;
      border-collapse: collapse;
      margin: 5px 0 8px;
    }
    table.doc-table td, table.doc-table th {
      padding: 4px 7px;
      border: 1px solid #E2E8F0;
      font-size: 8pt;
      vertical-align: middle;
    }
    table.doc-table th {
      background: #F8FAFC;
      color: #475569;
      font-weight: 700;
      text-align: left;
    }
    table.doc-table .td-label {
      font-weight: 600;
      background: #F8FAFC;
      color: #475569;
      width: 38%;
    }

    .summary-box {
      border: 1px solid #00D4AA;
      background: #F8FAFC;
      border-radius: 6px;
      padding: 8px 12px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      text-align: center;
      margin: 6px 0 10px;
    }
    .summary-item {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .summary-lbl {
      font-size: 7pt;
      text-transform: uppercase;
      color: #64748B;
      font-weight: 700;
      margin-bottom: 2px;
      letter-spacing: 0.5px;
    }
    .summary-val {
      font-size: 12pt;
      font-weight: 800;
      color: #0F172A;
    }
    .summary-val.accent {
      color: #00A884;
    }

    .bullet-list {
      list-style-type: disc;
      margin: 3px 0 6px 18px;
      padding: 0;
    }
    .bullet-list li {
      margin-bottom: 4px;
      font-size: 8pt;
      line-height: 1.38;
      color: #334155;
    }

    .sig-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      margin: 20px 0;
    }
    .sig-box {
      border-top: 1.5px solid #CBD5E1;
      padding-top: 10px;
      position: relative;
    }
    .sig-title {
      font-size: 8.5pt;
      font-weight: 800;
      text-transform: uppercase;
      color: #0F172A;
      margin-bottom: 12px;
      letter-spacing: 0.5px;
    }
    .sig-line {
      height: 48px;
      border-bottom: 1px dashed #CBD5E1;
      margin-bottom: 10px;
      display: flex;
      align-items: flex-end;
    }
    .sig-img {
      max-height: 46px;
      max-width: 100%;
      object-fit: contain;
    }

    @media print {
      @page { 
        size: A4; 
        margin: 12mm 15mm; 
      }
      body { 
        background: #ffffff; 
        -webkit-print-color-adjust: exact; 
        print-color-adjust: exact; 
        margin: 0;
        padding: 0;
      }
      .doc-page { 
        margin: 0; 
        padding: 0; 
        max-width: 100%; 
        min-height: 268mm; 
        height: 268mm;
        box-shadow: none; 
        page-break-after: always; 
        break-after: page; 
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .doc-page:last-of-type { 
        page-break-after: avoid; 
        break-after: avoid; 
      }
    }
  </style>
</head>
<body>

  <!-- PAGE 1 -->
  <div class="doc-page">
    ${renderHeader()}
    <div class="doc-content">
      <img class="doc-logo" src="${(() => { const p = (loan?.product || 'Swift30'); if (p === 'Swift15') return SWIFT15_LOGO_BASE64; if (p === 'Flex60' || p === 'Flex 60') return '/flex60.png'; if (p === 'FlexSure') return '/flexsure.png'; return SWIFT30_LOGO_BASE64; })()}" alt="${loan?.product || 'Swift30'}" />
      <div class="doc-subtitle">incorporating Adequate Capital Ltd&rsquo;s General Terms and Conditions (Kenya)</div>
      <div class="doc-meta">Agreement Ref: <b>${loanId}</b> &middot; Date: <b>${disbDate}</b></div>

      <p>This Agreement is made between Adequate Capital Ltd (&ldquo;Adequate&rdquo;, &ldquo;We&rdquo;, &ldquo;Our&rdquo; or &ldquo;us&rdquo;) and ${borrowerName}, the Borrower as defined herein (&ldquo;You&rdquo; or &ldquo;Your&rdquo;), for financial services provided through the mobile network, including the fixed-term Smart Cash loan facility described in Part A below. By signing, you confirm you have read, understood and agreed to be bound by the terms provided in both Part A (Specific Loan Terms) and Part B (General Terms and Conditions).</p>

      <p>The Borrower agrees that rights and obligations relating to the use of any Mobile Application (&ldquo;App&rdquo;) provided by Adequate may be subject to separate terms and conditions and/or an End User License Agreement (&ldquo;EULA&rdquo;) between Adequate and a third-party provider.</p>

      <div class="standing-box">
        <div class="standing-title">THIS AGREEMENT IS A STANDING AGREEMENT</div>
        <div class="standing-text">Once signed, this Agreement remains valid and binding for as long as the Borrower's Loan Account remains open. It automatically governs the initial Loan and every subsequent repeat loan, top-up or loan increment the Borrower takes from Adequate Capital Ltd. The Borrower does not need to sign a fresh agreement for each new Loan &mdash; each new Disbursement Request is made, and accepted, under the terms already agreed to here. See Clause 5.2 of Part B for the full provision.</div>
      </div>

      <div class="part-title">PART A &mdash; SPECIFIC LOAN TERMS</div>

      <div class="section-title">1. DEFINITIONS AND INTERPRETATION</div>
      <p>Unless the context otherwise requires, the following words and expressions bear the meanings set out below, and apply throughout both Part A and Part B of this Agreement:</p>

      <div class="clause"><b>1.1 &ldquo;Adequate&rdquo;</b> means Adequate Capital Ltd, a company duly registered in Kenya, and includes its subsidiaries and successors.</div>
      <div class="clause"><b>1.2 &ldquo;Administration Fee&rdquo;</b> means, where applicable, a fee charged on each Loan disbursed to the Borrower, calculated at the rate advertised by Adequate.</div>
      <div class="clause"><b>1.3 &ldquo;Agreement&rdquo;</b> means this Loan Facility Agreement, comprising the prescribed loan application (whether made in person, via the App, Short Code or USSD), Part A (Specific Loan Terms) and Part B (General Terms and Conditions).</div>
      <div class="clause"><b>1.4 &ldquo;App&rdquo;</b> means the mobile application used by Adequate and the Borrower to access Adequate's Services.</div>
      <div class="clause"><b>1.5 &ldquo;Assets&rdquo;</b> means all present and future stock, raw materials, goods, book debts, vehicles and other movable assets of the Borrower, as confirmed by the Borrower, including those listed in any Asset Declaration form.</div>
      <div class="clause"><b>1.6 &ldquo;Borrower&rdquo; or &ldquo;Client&rdquo;</b> means ${borrowerName}, the person to whom this facility is addressed, and includes his personal representatives or permitted assigns.</div>
      <div class="clause"><b>1.7 &ldquo;Business Day&rdquo;</b> means any day other than a Saturday, Sunday or public holiday declared in the Republic of Kenya.</div>
      <div class="clause"><b>1.8 &ldquo;Disbursement Request&rdquo;</b> means a loan request submitted by the Borrower in the prescribed form, including digital loan increment requests; <b>&ldquo;Disbursement Date&rdquo;</b> means the date on which the Loan is disbursed pursuant to such a request.</div>
      <div class="clause"><b>1.9 &ldquo;EULA&rdquo;</b> means End User License Agreement.</div>
      <div class="clause"><b>1.10 &ldquo;Event of Default&rdquo;</b> means any of the events specified in Clause 12 of Part B.</div>
      <div class="clause"><b>1.11 &ldquo;Interest&rdquo;</b> means interest payable to Adequate at the rate advertised, being ${interestRateText} as set out in Section 3 of Part A for this Loan.</div>
    </div>
    ${renderFooter(1)}
  </div>

  <!-- PAGE 2 -->
  <div class="doc-page">
    ${renderHeader()}
    <div class="doc-content">
      <div class="clause"><b>1.12 &ldquo;Late Payment Fee&rdquo;</b> means the fee payable on late repayment of the Repayment Amount, reflected for this Loan as the Default Interest rate in Clause 3.4 of Part A.</div>
      <div class="clause"><b>1.13 &ldquo;Loan&rdquo;</b> means the fixed-term Smart Cash loan in the sum specified in the Disbursement Request and Section 3 below.</div>
      <div class="clause"><b>1.14 &ldquo;Membership Fee&rdquo;</b> has the same meaning as &ldquo;Registration Fee&rdquo;.</div>
      <div class="clause"><b>1.15 &ldquo;Registration Fee&rdquo;</b> means the one-off charge levied on a first-time Borrower, where applicable.</div>
      <div class="clause"><b>1.16 &ldquo;Repayment Amount&rdquo;</b> means the outstanding Loan and all or any Membership Fee, Interest, Administration Fee and applicable Late Payment Fee.</div>
      <div class="clause"><b>1.17 &ldquo;Repayment Date&rdquo;</b> means the date specified for repayment of the Loan, as given in the disbursement confirmation.</div>
      <div class="clause"><b>1.18 &ldquo;Services&rdquo;</b> means any financial services or products Adequate may offer the Borrower under this Agreement.</div>
      <div class="clause"><b>1.19 &ldquo;Short Code&rdquo;</b> means the telephone number code(s) used by Adequate.</div>
      <div class="clause"><b>1.20 &ldquo;Smart Cash&rdquo;</b> means the provision of short-term cash loans for the purchase of Stock and other revenue-generating activities agreed with Adequate.</div>
      <div class="clause"><b>1.21 &ldquo;Stock&rdquo;</b> means items for sale purchased by the Borrower from the proceeds of the Loan.</div>
      <div class="clause"><b>1.22 &ldquo;System&rdquo;</b> means Adequate's electronic banking and communications software enabling the Client to communicate with Adequate.</div>
      <div class="clause"><b>1.23 &ldquo;Transaction Fees&rdquo;</b> means the fees and charges payable for use of the Services, as published by Adequate.</div>
      <div class="clause"><b>1.24 &ldquo;CRB&rdquo;</b> means a Credit Reference Bureau licensed under the laws of Kenya.</div>

      <p style="margin-top: 8px;">Headings are for convenience only. Words importing the masculine include the feminine and juristic persons; the singular includes the plural and vice versa, where the context requires.</p>

      <div class="section-title">2. PERSONAL &amp; BUSINESS INFORMATION</div>
      <div class="subsection-title">2.1 Borrower Details</div>
      <table class="doc-table">
        <tr><td class="td-label">Borrower Name</td><td>${borrowerName}</td></tr>
        <tr><td class="td-label">National ID</td><td>${nationalId}</td></tr>
        <tr><td class="td-label">Phone Number</td><td>${phoneNo}</td></tr>
        <tr><td class="td-label">Residence</td><td>${residence}</td></tr>
      </table>

      <div class="subsection-title">2.2 Business Details</div>
      <table class="doc-table">
        <tr><td class="td-label">Business Name</td><td>${businessName}</td></tr>
        <tr><td class="td-label">Business Type</td><td>${businessType}</td></tr>
        <tr><td class="td-label">Location</td><td>${businessLocation}</td></tr>
        <tr><td class="td-label">Customer ID</td><td>${customerId}</td></tr>
      </table>

      <p style="margin-top: 8px;">The Borrower warrants that the information above is true, accurate and complete as at the Effective Date and undertakes to notify Adequate promptly, and in any event within seven (7) days, of any change to it.</p>
    </div>
    ${renderFooter(2)}
  </div>

  <!-- PAGE 3 -->
  <div class="doc-page">
    ${renderHeader()}
    <div class="doc-content">
      <div class="section-title">3. FINANCIAL TERMS</div>
      <div class="summary-box">
        <div class="summary-item">
          <div class="summary-lbl">PRINCIPAL AMOUNT</div>
          <div class="summary-val">${fmtAmt(principal)}</div>
        </div>
        <div class="summary-item">
          <div class="summary-lbl">INTEREST (${interestPercentLabel})</div>
          <div class="summary-val">${fmtAmt(interestAmt)}</div>
        </div>
        <div class="summary-item">
          <div class="summary-lbl">TOTAL REPAYABLE</div>
          <div class="summary-val accent">${fmtAmt(totalRepay)}</div>
        </div>
      </div>

      <table class="doc-table">
        <tr>
          <td class="td-label">Repayment Frequency</td>
          <td>${n(loan?.repaymentType || "Monthly")}</td>
        </tr>
        <tr>
          <td class="td-label">Loan Term</td>
          <td>${loanDays} days, unless otherwise stipulated</td>
        </tr>
        <tr>
          <td class="td-label">Due Date</td>
          <td><b>${dueDateFormatted}</b></td>
        </tr>
        <tr>
          <td class="td-label">Installment Amount</td>
          <td><b>${repSched()}</b></td>
        </tr>
        <tr>
          <td class="td-label">Disbursement Reference</td>
          <td>${(loan?.mpesa || loan?.mpesa_code) ? `<b>${n(loan.mpesa || loan.mpesa_code)}</b>` : '<span style="color: #64748B; font-style: italic;">Pending disbursement (Generated upon M-Pesa release)</span>'}</td>
        </tr>
        <tr>
          <td class="td-label">Disbursement Channel / M-Pesa Paybill</td>
          <td><b>4166191</b></td>
        </tr>
        <tr>
          <td class="td-label">M-Pesa Account Number</td>
          <td><b>${nationalId}</b> (Borrower National ID)</td>
        </tr>
        <tr>
          <td class="td-label">Registration / Membership Fee</td>
          <td>Not applicable to this Loan</td>
        </tr>
        <tr>
          <td class="td-label">Administration Fee</td>
          <td>Not applicable to this Loan</td>
        </tr>
      </table>

      <div class="clause"><b>3.1</b> Interest is charged on a flat-rate basis at ${interestRateText} of the Principal, fixed for the tenor of the Loan and does not reduce as the Principal is repaid, unless Adequate agrees otherwise in writing.</div>
      <div class="clause"><b>3.2</b> No Registration Fee, Membership Fee or Administration Fee applies to this Loan unless expressly shown in the table above; where any such fee does apply to a future or repeat Loan, it will be disclosed in the applicable Disbursement Request and added to the Repayment Amount.</div>
      <div class="clause"><b>3.3</b> All amounts are in Kenya Shillings (KES) unless otherwise stated.</div>
      <div class="clause"><b>3.4 Default Interest:</b> Following an Event of Default (see Clause 12 of Part B), default interest shall accrue on the outstanding balance at a rate of 1.2% per day until the outstanding balance, together with all accrued default interest and recovery costs, is settled in full.</div>
      <div class="clause"><b>3.5 Immediate Recall:</b> On Default, Adequate may, at its discretion, declare the entire outstanding balance immediately due and payable, without further notice, in addition to any other remedy available to it, including the recovery options set out in Clause 13 of Part B.</div>

      <div class="section-title" style="margin-top: 10px;">4. NEXT OF KIN &amp; REFEREES</div>
      <p>The Borrower has nominated the following next of kin and/or referees, who may be contacted by Adequate in connection with this facility, including for debt collection and verification purposes described in Clause 16 (Disclosure &amp; References):</p>

      <table class="doc-table">
        <thead>
          <tr>
            <th style="width: 10%;">#</th>
            <th style="width: 35%;">Full Name</th>
            <th style="width: 25%;">Contact Phone</th>
            <th style="width: 30%;">Relationship</th>
          </tr>
        </thead>
        <tbody>
          ${refereeRows()}
        </tbody>
      </table>

      <div class="clause"><b>4.1</b> The Borrower confirms to Adequate that they have consent to share the above referee contact details and confirms the referees understand they may be contacted.</div>
    </div>
    ${renderFooter(3)}
  </div>

  <!-- PAGE 4 -->
  <div class="doc-page">
    ${renderHeader()}
    <div class="doc-content">
      <div class="part-title">PART B &mdash; GENERAL TERMS AND CONDITIONS (KENYA)</div>
      <p>This Part B sets out the complete general Terms and Conditions (&ldquo;T&amp;Cs&rdquo;) applicable to the loan facility offered by Adequate to the Borrower, including the initial Loan and every subsequent repeat loan or loan increment request. These T&amp;Cs, and any amendments, take effect on the date of the Borrower's loan application.</p>

      <div class="section-title">5. ACCEPTANCE OF THE TERMS AND CONDITIONS</div>
      <div class="clause"><b>5.1</b> By signing the Loan Agreement, You confirm you have read, understood and agree to be bound by these T&amp;Cs and any subsequent amendments governing the operation of the Adequate App and Loan Account, without prejudice to any right Adequate may have in law or otherwise.</div>
      <div class="clause-sub"><b>5.1.1</b> You consent to the collection of the personal data provided herein for purposes of opening and operating a Loan Account and subsequent incidental products.</div>
      <div class="clause-sub"><b>5.1.2</b> You agree to receive communication regarding products offered by Adequate.</div>
      <div class="clause"><b>5.2 Standing Agreement &mdash; No Re-Signing for Future Loans:</b> This Agreement, once signed, constitutes a continuing, standing agreement between You and Adequate for the duration of your relationship with Adequate. It applies automatically to the initial Loan and to every subsequent repeat loan, top-up, or loan increment request You make, whether via the App, Short Code, USSD or any other channel Adequate makes available. You are not required to sign a new agreement, or any further physical or digital copy of these T&amp;Cs, before each subsequent Loan is disbursed; submitting a Disbursement Request under an existing Loan Account is sufficient acceptance of, and constitutes your agreement to be bound by, the T&amp;Cs in force at that time.</div>
      <div class="clause"><b>5.3</b> Where Adequate amends these T&amp;Cs under Clause 25.1, the amended terms shall apply to all Loans disbursed after the amendment takes effect; Adequate will make reasonable efforts to notify You of material changes through the App, SMS or other agreed channel.</div>

      <div class="section-title">6. ACCOUNT OPENING</div>
      <div class="clause"><b>6.1</b> To qualify to open and operate an Adequate Loan Account, You:</div>
      <div class="clause-sub"><b>6.1.1</b> must be at least 18 years old;</div>
      <div class="clause-sub"><b>6.1.2</b> must be the owner of a business of at least six (6) months' standing;</div>
      <div class="clause-sub"><b>6.1.3</b> must be assessed to be of satisfactory creditworthiness by Adequate;</div>
      <div class="clause-sub"><b>6.1.4</b> must possess a mobile telephone number.</div>
      <div class="clause"><b>6.2</b> You agree and authorize Adequate to contact your mobile service provider to verify your details as part of Adequate's KYC procedures.</div>
      <div class="clause"><b>6.3</b> You agree and authorize Adequate to verify your personal details from Government bodies or any other authorized body able to verify such details.</div>
      <div class="clause"><b>6.4</b> Adequate reserves the right to request further information pertaining to your application as part of its KYC procedures. Failure to provide such information may negatively affect your ability to open an account or qualify for a Loan.</div>
      <div class="clause"><b>6.5</b> Acceptance by Adequate of an application for a Loan Account shall be communicated via SMS to the mobile telephone number registered at the point of application.</div>
      <div class="clause"><b>6.6</b> Adequate reserves the right to decline your application, or to revoke it, at its sole discretion.</div>

      <div class="section-title">7. BORROWER'S REQUESTS</div>
      <div class="clause"><b>7.1</b> You irrevocably authorize Adequate to act on all requests received from You through the System and to hold You liable accordingly. Adequate may nevertheless refuse to carry out any request that would result in a default on your Account.</div>
    </div>
    ${renderFooter(4)}
  </div>

  <!-- PAGE 5 -->
  <div class="doc-page">
    ${renderHeader()}
    <div class="doc-content">
      <div class="clause"><b>7.2</b> Adequate is entitled to accept and act upon any request, even if incomplete or ambiguous, where it believes in its absolute discretion that it can correct such information without reference to You.</div>
      <div class="clause"><b>7.3</b> Adequate shall be deemed to have fully performed its obligations notwithstanding that a request was initiated, sent or communicated in error or fraudulently, and You shall be bound by any request Adequate has in good faith believed to have come from You.</div>
      <div class="clause"><b>7.4</b> Adequate may, in its absolute discretion, decline to act on the whole or any part of a request pending further enquiry or confirmation, and shall not be liable for so declining.</div>
      <div class="clause"><b>7.5</b> You agree to release and indemnify Adequate against all claims, losses, damages, costs and expenses arising from Adequate having acted (or declined to act) on any of your requests.</div>
      <div class="clause"><b>7.6</b> Adequate shall not be liable for any unauthorized drawing, transfer, remittance, disclosure or activity on your Account howsoever occurring.</div>
      <div class="clause"><b>7.7</b> A successfully submitted request can only be cancelled by contacting Adequate's Contact Centre or visiting a branch, and only where the request is revocable and has not yet been processed; a cancellation fee may apply.</div>
      <div class="clause"><b>7.8</b> Adequate is authorized to act on any court order or directive from a competent authority in respect of your Account.</div>
      <div class="clause"><b>7.9</b> In the event of any conflict between a request received by Adequate and these T&amp;Cs, these T&amp;Cs shall prevail.</div>

      <div class="section-title">8. THE LOAN &amp; DISBURSEMENT</div>
      <div class="clause"><b>8.1</b> Subject to these T&amp;Cs, Adequate agrees to make available to You such Loans as may be approved on application during the term of this Agreement.</div>
      <div class="clause"><b>8.2</b> Unless otherwise stipulated, the Loan term is ${isSwift15 ? 'fifteen (15)' : isFlex60 ? 'sixty (60)' : 'thirty (30)'} days.</div>
      <div class="clause"><b>8.3</b> You will receive confirmation of the amount applied for and disbursed to your mobile phone. Any challenge to the amount disbursed must be raised within twelve (12) hours of disbursement.</div>
      <div class="clause"><b>8.4</b> You have sole responsibility for repaying all amounts disbursed to the mobile phone attached to your Account.</div>
      <div class="clause"><b>8.5</b> The Loan will be used to finance the purchase of Stock and such other revenue-generating activity as may be agreed with Adequate.</div>
      <div class="clause"><b>8.6</b> The Loan will be disbursed in full within forty-eight (48) hours of validation of the Disbursement Request.</div>
      <div class="clause"><b>8.7</b> Adequate may, at any time prior to the Disbursement Date, cancel the provision of the Loan.</div>

      <div class="section-title">9. CHARGES</div>
      <div class="clause"><b>9.1</b> You shall pay Interest and all requisite fees (where applicable) on each Loan as tabulated for each application; these sums are added to the Repayment Amount and are payable on the Repayment Date.</div>
      <div class="clause-sub"><b>9.1.1</b> Late payments attract a Late Payment Fee, added to the Repayment Amount.</div>
      <div class="clause-sub"><b>9.1.2</b> If your Account remains in arrears, Adequate reserves the right to take further recovery action as it deems appropriate.</div>
      <div class="clause"><b>9.2</b> The rate or amount of Interest / Late Payment Fee stated by Adequate shall, in the absence of manifest error, be conclusive.</div>

      <div class="section-title">10. REPAYMENT TERMS</div>
      <div class="clause"><b>10.1</b> The Repayment Amount shall be paid on or before the Repayment Date specified in the disbursement confirmation message.</div>
    </div>
    ${renderFooter(5)}
  </div>

  <!-- PAGE 6 -->
  <div class="doc-page">
    ${renderHeader()}
    <div class="doc-content">
      <div class="clause"><b>10.2</b> Payments shall be made only through mobile money into Adequate's specified Paybill (4166191), using the Borrower's National ID Number (${nationalId}) as the Account Number, in cleared funds no later than 11:59 p.m. EAT on the Repayment Date.</div>
      <div class="clause"><b>10.3</b> Payments shall be made in full without set-off or counterclaim and free of any present or future taxes or deductions, save as required by law, in which case the sum due shall be grossed up so that Adequate receives the full amount it would otherwise have received; You shall indemnify Adequate for any related loss.</div>
      <div class="clause"><b>10.4</b> You may repay before the due date without penalty for such early payment.</div>
      <div class="clause"><b>10.5</b> Payments received shall be applied first to outstanding fees or recovery costs, then to accrued Default Interest, then to Interest, and finally to Principal.</div>
      <div class="clause"><b>10.6</b> Adequate shall, on request, provide a statement or receipt confirming payments received and the outstanding balance.</div>

      <div class="section-title">11. REPRESENTATIONS, WARRANTIES &amp; LIABILITIES</div>
      <p>You represent and warrant to Adequate, as at the date of this Agreement and on the Disbursement Date of each Loan, that:</p>
      <div class="clause"><b>11.1</b> you have capacity to enter into this Agreement;</div>
      <div class="clause"><b>11.2</b> there is no pending or, to your knowledge, threatened action or legal proceeding against you that may materially affect your ability to repay the Loan;</div>
      <div class="clause"><b>11.3</b> you are not in breach of or in default under any agreement relating to financial indebtedness, including any other product from Adequate;</div>
      <div class="clause"><b>11.4</b> all factual information supplied to Adequate is true, no material information has been omitted, and all projections, statements of belief and opinion have been made in good faith;</div>
      <div class="clause"><b>11.5</b> you will indemnify, hold harmless and defend Adequate, its employees and affiliates from all claims and suits by third parties for damages, injury (including death), property damage, losses and expenses (including legal costs) arising from either party's performance under this Agreement.</div>

      <div class="section-title">12. EVENTS OF DEFAULT</div>
      <p>Adequate shall cease to be under any commitment to You and all money obligations shall immediately become due on the occurrence of any of the following Events of Default:</p>
      <div class="clause"><b>12.1</b> You fail to repay any Loan on the terms on which it was disbursed;</div>
      <div class="clause"><b>12.2</b> any information provided by You in the application, or to Adequate's representatives, proves inaccurate or misleading;</div>
      <div class="clause"><b>12.3</b> any representation or warranty made by You proves untrue or incorrect in any material respect;</div>
      <div class="clause"><b>12.4</b> You become bankrupt, or make or seek an arrangement with your creditors;</div>
      <div class="clause"><b>12.5</b> any distress or execution is levied on or affects any of your property or assets;</div>
      <div class="clause"><b>12.6</b> upon your death;</div>
      <div class="clause"><b>12.7</b> by reason of illness or incapacity, You become incapable of managing your own affairs or become a patient under mental health legislation;</div>
      <div class="clause"><b>12.8</b> Adequate may, without prejudice to its other rights, upon and at any time after an Event of Default that is continuing, demand payment of the entire amount outstanding on all Loans disbursed to You. This is in addition to, and does not limit, the Default Interest and recovery provisions set out in Clauses 3.4 and 3.5 of Part A and Clause 13 of Part B.</div>
    </div>
    ${renderFooter(6)}
  </div>

  <!-- PAGE 7 -->
  <div class="doc-page">
    ${renderHeader()}
    <div class="doc-content">
      <div class="section-title">13. SECURITY, RECOVERY &amp; COLLATERAL</div>
      <p>Upon an Event of Default, Adequate may use any one or more of the following recovery options, at its discretion and without prejudice to any other remedy available to it in law or under this Agreement:</p>
      <div class="clause"><b>13.1 Reversal of Disbursed Funds:</b> Where the Loan proceeds remain traceable and recoverable through the mobile money or other disbursement channel used, You authorize Adequate to initiate a reversal of the disbursed amount (or any undisbursed or unutilized portion of it) through that channel, or to request the relevant mobile network operator or payment service provider to do so, to the extent permitted by applicable law and that provider's operating rules.</div>
      <div class="clause"><b>13.2 Repossession &amp; Sale of Security:</b> You authorize Adequate to recover the outstanding debt through repossession and sale of the assets listed in the associated Asset Declaration form, or any other property lawfully owned by You, to the extent necessary to satisfy the outstanding balance.</div>
      <div class="clause"><b>13.3 Recovery Costs:</b> You shall bear all reasonable costs of recovery arising from a Default, including auctioneer's fees, legal costs, and any costs directly incurred by Adequate in recovering the outstanding balance (including in effecting a reversal under Clause 13.1), subject to applicable law.</div>
      <div class="clause"><b>13.4 Surplus:</b> Where amounts recovered under Clause 13.1 or 13.2 exceed the amount owed by You (including recovery costs), Adequate shall account to You for the surplus within a reasonable time.</div>
      <div class="clause"><b>13.5 Lawful Process:</b> Any reversal, repossession or sale under this Clause 13 shall be carried out in accordance with applicable Kenyan law, including any statutory notice requirements.</div>

      <div class="section-title">14. ASSIGNMENT AND TRANSFER</div>
      <div class="clause"><b>14.1</b> You may not assign or transfer any of your rights or obligations under this Agreement.</div>
      <div class="clause"><b>14.2</b> Adequate may assign or transfer all or any of its rights and obligations under this Agreement, and may change its lending office.</div>
      <div class="clause"><b>14.3</b> You will execute all documents Adequate reasonably requires to give effect to such assignment or transfer.</div>
      <div class="clause"><b>14.4</b> This Agreement binds You, Adequate and their respective successors and permitted assigns.</div>

      <div class="section-title">15. DISCLOSURE &amp; REFERENCES</div>
      <div class="clause"><b>15.1</b> Adequate may disclose information about You and/or the Loans disbursed as it considers appropriate to any licensed CRB, any person with whom Adequate is associated, and/or any actual or potential assignee or transferee of this Agreement.</div>
      <div class="clause"><b>15.2</b> Information shared by Adequate is subject to Adequate's standard non-disclosure arrangements where applicable.</div>
      <div class="clause"><b>15.3</b> Notwithstanding Clause 15.2, Adequate is not liable for any misuse of information or breach of confidentiality by third parties.</div>
      <div class="clause"><b>15.4</b> You authorize the collection of references concerning You, your conduct and commercial credit, and authorize the issuance of credit history reports to Adequate, absolving the reporting party of responsibility for doing so.</div>

      <div class="section-title">16. DATA PROTECTION</div>
      <div class="clause"><b>16.1</b> Adequate's Privacy Policy explains how Adequate collects and processes your personal data. By agreeing to these T&amp;Cs, You consent to the collection and use of your personal data as described here and in that Policy.</div>
      <div class="clause"><b>16.2 Information Collected:</b> Adequate may collect, use, store and transfer personal data about You that You have provided, that is publicly available, that is acquired through use of its products, or that is requested from its partners to fulfil a statutory or contractual obligation, including but not limited to:</div>
    </div>
    ${renderFooter(7)}
  </div>

  <!-- PAGE 8 -->
  <div class="doc-page">
    ${renderHeader()}
    <div class="doc-content">
      <ul class="bullet-list">
        <li><b>Identity data</b> &mdash; name, username or similar identifiers, marital status, title, date of birth and gender;</li>
        <li><b>Contact data</b> &mdash; business location, residential address, e-mail address and telephone numbers;</li>
        <li><b>Referee contact details</b> you provide (with your confirmation that you have consent to share them);</li>
        <li><b>Financial data</b> relevant to processing the loan application;</li>
        <li><b>Transaction data</b> &mdash; details of payments to and from You and any other Adequate products applied for;</li>
        <li><b>Technical data</b> &mdash; IP address, login data, browser/device type, time zone, operating system and platform;</li>
        <li><b>Profile and usage data</b> &mdash; username, purchases, interests, preferences, feedback and Short Code interactions;</li>
        <li><b>Marketing and communications data</b> &mdash; your preferences for receiving marketing and communications.</li>
      </ul>

      <div class="subsection-title">16.3 Use</div>
      <p>Data collected is used in accordance with applicable privacy laws in force at the time of disbursement, including but not limited to: opening a Loan Account; performing Adequate's contractual obligations to You; complying with legal obligations; and informing You of changes or additions to Adequate's products.</p>

      <div class="subsection-title">16.4 Transfer</div>
      <div class="clause"><b>16.4.1</b> Information collected may be processed and stored by Adequate's service providers located outside the country of disbursement.</div>
      <div class="clause"><b>16.4.2</b> Adequate has measures in place to protect the privacy of data in its possession and in transit.</div>
      <div class="clause"><b>16.4.3</b> To the best of its knowledge, Adequate's third-party providers have implemented appropriate data privacy protections, and your data will only be transferred to providers deemed to offer an adequate level of protection.</div>

      <div class="subsection-title">16.5 Privacy</div>
      <div class="clause"><b>16.5.1</b> Adequate has appropriate security measures to prevent your personal data from being altered, disclosed, used or accessed without authorization.</div>
      <div class="clause"><b>16.5.2</b> Access to your personal data is limited to employees, agents, contractors and other third parties whose access is required for Adequate to provide its products.</div>
      <div class="clause"><b>16.5.3</b> Adequate will only disclose your personal information with your consent, save as otherwise permitted or required by law.</div>

      <div class="section-title">17. NOTICES</div>
      <div class="clause"><b>17.1</b> All notices under this Agreement shall be in writing and sent by letter, e-mail, SMS, in-App message or fax (unless stated otherwise), and are deemed given at 9:00 a.m. on the following Business Day (personal delivery), or on the date shown on the acknowledgement receipt.</div>
      <div class="clause"><b>17.2</b> For e-mail, SMS, in-App or fax, notice is deemed given when dispatched, provided a transmission receipt is obtained and a hard copy is thereafter sent by prepaid post; or ten (10) days after posting by registered mail (for letters), to the address specified below or as otherwise notified in writing.</div>

      <div class="subsection-title">17.3 Address for Service &mdash; Adequate</div>
      <table class="doc-table">
        <tr><td class="td-label">Company</td><td>Adequate Capital Ltd</td></tr>
        <tr><td class="td-label">Postal Address</td><td>P.O. Box 253-00241, Kitengela</td></tr>
        <tr><td class="td-label">Email</td><td>info@adequatecapital.co.ke</td></tr>
      </table>

      <div class="clause" style="margin-top: 6px;"><b>17.4</b> A notice received on a day other than a Business Day at the place of receipt is deemed given at 9:00 a.m. on the next Business Day.</div>
    </div>
    ${renderFooter(8)}
  </div>

  <!-- PAGE 9 -->
  <div class="doc-page">
    ${renderHeader()}
    <div class="doc-content">
      <div class="section-title">18. REMEDIES</div>
      <div class="clause"><b>18.1</b> No failure or delay by Adequate in exercising any power, right or remedy under this Agreement operates as a waiver of it, nor does any single or partial exercise preclude further exercise, or the exercise of any other right or remedy. Remedies under this Agreement are cumulative and not exclusive of remedies available by law.</div>

      <div class="section-title">19. SEVERANCE</div>
      <div class="clause"><b>19.1</b> If any provision of this Agreement is deemed illegal, invalid or unenforceable under the law of the jurisdiction in which it operates, that provision shall be severed and rendered ineffective without affecting the enforceability of the remaining provisions.</div>

      <div class="section-title">20. DISPUTE RESOLUTION</div>
      <div class="clause"><b>20.1</b> Disputes may be reported to Adequate's Client Contact Centre.</div>
      <div class="clause"><b>20.2</b> The Parties shall first exhaust internal dispute-resolution mechanisms before referring a matter to arbitration.</div>
      <div class="clause"><b>20.3</b> Failing amicable resolution, a dispute may be referred to a single arbitrator agreed between the Parties or, in default of agreement within sixty (60) days of notification of the dispute, appointed on application of either Party by the Chairman of the Chartered Institute of Arbitrators (Kenya Branch). Arbitration shall be conducted in English, in Nairobi, under that Institute's Rules of Arbitration and the Arbitration Act, 1995.</div>
      <div class="clause"><b>20.4</b> To the extent permissible by law, the arbitrator's determination shall be final, conclusive and binding on the Parties.</div>
      <div class="clause"><b>20.5</b> This Agreement is governed by and construed in accordance with the laws of the Republic of Kenya.</div>

      <div class="section-title">21. COMPLAINTS</div>
      <div class="clause"><b>21.1</b> To raise a complaint, contact Adequate's Contact Centre at info@adequatecapital.co.ke.</div>

      <div class="section-title">22. TERMINATION</div>
      <div class="clause"><b>22.1</b> You may close a zero-balance Account by sending a written request to Adequate.</div>
      <div class="clause"><b>22.2</b> Adequate may, at any time, suspend or close your Loan Account and demand immediate payment of any outstanding Loan amount where:</div>
      <div class="clause-sub"><b>22.2.1</b> the details provided to open the Account were false;</div>
      <div class="clause-sub"><b>22.2.2</b> the user of the Account is found to be under 18;</div>
      <div class="clause-sub"><b>22.2.3</b> the Account is used for unauthorized purposes;</div>
      <div class="clause-sub"><b>22.2.4</b> new legislation, subsidiary legislation or a government directive necessitates closure;</div>
      <div class="clause-sub"><b>22.2.5</b> closure is necessitated by technical challenges;</div>
      <div class="clause-sub"><b>22.2.6</b> any activity is deemed to breach the EULA.</div>
      <div class="clause"><b>22.3</b> Adequate shall not be liable for any loss suffered by You on account of a closure carried out for any of the reasons listed above.</div>
    </div>
    ${renderFooter(9)}
  </div>

  <!-- PAGE 10 -->
  <div class="doc-page">
    ${renderHeader()}
    <div class="doc-content">
      <div class="section-title">23. USER LICENSE (APP)</div>
      <div class="clause"><b>23.1</b> Subject to these T&amp;Cs, You are granted a personal, non-exclusive, non-transferable, non-sub-licensable, revocable licence to download, display and use the App (including its text, graphics, images, data, displays and illustrations) in connection with the Loan and any Adequate product made available through it.</div>
      <div class="clause"><b>23.2</b> This licence excludes any right to sell, resell, copy, reproduce, distribute, modify, remove proprietary notices from, or otherwise make derivative use of the App, or to use it other than for its intended purpose.</div>

      <div class="section-title">24. FORCE MAJEURE</div>
      <p>Neither Party shall be liable for any delay or failure to perform its obligations under this Agreement (other than an obligation to pay money) to the extent caused by circumstances beyond that Party's reasonable control, including natural disaster, civil unrest, government action, or failure of telecommunications or mobile money infrastructure, provided the affected Party gives notice as soon as reasonably practicable and takes reasonable steps to mitigate the impact.</p>

      <div class="section-title">25. MISCELLANEOUS</div>
      <div class="clause"><b>25.1</b> Adequate reserves the right to amend these T&amp;Cs and the Transaction Fees without notice.</div>
      <div class="clause"><b>25.2 Anti-Corruption:</b> The Borrower confirms they have not received or been offered any illegal or improper bribe, kickback, payment, gift or thing of value from any of Adequate's employees or agents in connection with this Agreement.</div>
      <div class="clause"><b>25.3</b> Reasonable gifts and entertainment provided in the ordinary course of business do not violate Clause 25.2. Any violation should be reported to: info@adequatecapital.co.ke.</div>
      <div class="clause"><b>25.4</b> No variation of this Agreement shall be effective unless made in writing and signed by both Parties, save that Adequate may update fees or processes in accordance with applicable law and Clause 25.1.</div>
      <div class="clause"><b>25.5</b> This Agreement, together with any Asset Declaration form and documents expressly referred to herein, constitutes the entire agreement between the Parties relating to this facility and supersedes all prior discussions or representations.</div>

      <div class="section-title">26. CONSENT TO USE OF DATA</div>
      <p>You consent to the collection, use and transfer of your data as described in Clause 16 above and in Adequate's Privacy Policy, including storage on-site and in Adequate's service providers' cloud facilities, which may be located outside the jurisdiction where the loan application was executed. You understand that declining this consent may affect your loan application, and that by indicating &ldquo;YES&rdquo; below, you confirm you understand how and why Adequate will use your data and have freely and unequivocally consented to its use.</p>

      <p style="margin-top: 10px; font-weight: 700; color: #0F172A;">I CONSENT TO THE USE OF MY DATA</p>
      <div style="display: flex; gap: 24px; margin: 8px 0 14px; font-size: 8.5pt; font-weight: 600;">
        <span style="display: flex; align-items: center; gap: 6px;">
          <span style="display: inline-block; width: 14px; height: 14px; border: 1.5px solid #0F172A; text-align: center; line-height: 12px; font-size: 11px; font-weight: bold; background: #fff;">&#10003;</span>
          YES
        </span>
        <span style="display: flex; align-items: center; gap: 6px;">
          <span style="display: inline-block; width: 14px; height: 14px; border: 1.5px solid #0F172A; background: #fff;"></span>
          NO
        </span>
      </div>
    </div>
    ${renderFooter(10)}
  </div>

  <!-- PAGE 11 -->
  <div class="doc-page">
    ${renderHeader()}
    <div class="doc-content">
      <div class="section-title">27. DECLARATION &amp; EXECUTION</div>
      <p style="font-size: 8.5pt; line-height: 1.45; margin-bottom: 20px;">I, <b>${borrowerName}</b>${nationalId && nationalId !== 'ΓÇö' ? ` (ID No. <b>${nationalId}</b>)` : ''}, confirm that I have understood the contents of this Agreement &mdash; including Part A (Specific Loan Terms) and Part B (General Terms and Conditions) &mdash; and consent to the collection of my data as described in Clause 16 and Clause 26 above. I execute this Agreement voluntarily.</p>

      <div class="sig-grid">
        <div class="sig-box">
          <div class="sig-title">BORROWER SIGNATURE</div>
          <div class="sig-line">
            ${loan?.borrower_signature ? `<img src="${loan.borrower_signature}" class="sig-img" alt="Borrower Signature" />` : ''}
          </div>
          <div style="font-weight: 700; font-size: 9pt; color: #0F172A;">${borrowerName}</div>
          <div style="font-size: 8pt; color: #64748B;">ID: ${nationalId} &nbsp;&middot;&nbsp; Date: ${disbDate}</div>
        </div>

        <div class="sig-box" style="position: relative;">
          ${ADEQUATE_STAMP_BASE64 ? `
          <div style="position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%) rotate(-8deg); opacity: 0.85; width: 220px; height: 220px; pointer-events: none; filter: saturate(2.5) contrast(1.8) brightness(0.9);">
            <img src="${ADEQUATE_STAMP_BASE64}" alt="Stamp" style="width: 100%; height: 100%; display: block;" />
            <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; font-family: 'Courier New', Courier, monospace; font-size: 13px; font-weight: 900; color: #dc2626; letter-spacing: 0px; padding-right: 10px; padding-bottom: 2px;">
              ${stampDateStr}
            </div>
          </div>
          ` : ''}
          <div class="sig-title">FOR ADEQUATE CAPITAL LTD</div>
          <div class="sig-line">
            ${loan?.officer_signature ? `<img src="${loan.officer_signature}" class="sig-img" alt="Officer Signature" />` : ''}
          </div>
          <div style="font-weight: 700; font-size: 9pt; color: #0F172A;">${officerName}</div>
          <div style="font-size: 8pt; color: #64748B;">Date: ${disbDate}</div>
        </div>
      </div>

      <p style="text-align: center; font-size: 7.5pt; color: #64748B; margin-top: 35px;">
        Adequate Capital Ltd &middot; P.O. Box 253-00241, Kitengela &middot; info@adequatecapital.co.ke &middot; Paybill: 4166191 &middot; T: 0727 625 470 / 0714 256 816
      </p>
    </div>
    ${renderFooter(11)}
  </div>

</body>
</html>
`;
};

export const generateAssetListHTML = (loan, customer, officer, format = 'html') => {
  const today = new Date().toLocaleDateString("en-KE", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
  const fmtAmt = (v) => "KES " + Number(v || 0).toLocaleString("en-KE");
  const n = safeStr;
  const isFlexSure = loan.product === 'FlexSure' && loan.collateralName;
  const desc = isFlexSure 
    ? n(loan.collateralName) + (loan.collateralSerial ? ' (SN: ' + n(loan.collateralSerial) + ')' : '') 
    : 'All business assets and home items to be used to recover company money in case of default.';
  
  const loc = isFlexSure ? n(loan.collateralStorage) : '';
  const val = isFlexSure && loan.collateralMarketValue ? fmtAmt(loan.collateralMarketValue) : '';
  const cond = isFlexSure && loan.collateralCondition ? n(loan.collateralCondition) : '';
  const ownership = isFlexSure ? 'Confirmed' : '';
  
  const rowsHtml = [
    "<tr><td style='padding:6px 10px;border:1px solid #E2E8F0'>1</td>" +
    "<td style='padding:6px 10px;border:1px solid #E2E8F0'><b>" + desc + "</b></td>" +
    "<td style='padding:6px 10px;border:1px solid #E2E8F0'>" + loc + "</td>" +
    "<td style='padding:6px 10px;border:1px solid #E2E8F0'>" + val + "</td>" +
    "<td style='padding:6px 10px;border:1px solid #E2E8F0'>" + cond + "</td>" +
    "<td style='padding:6px 10px;border:1px solid #E2E8F0'>" + ownership + "</td></tr>"
  ].concat(Array.from(
    { length: 4 },
    (_, i) =>
      "<tr><td style='padding:6px 10px;border:1px solid #E2E8F0'>" +
      (i + 2) +
      "</td>" +
      "<td style='padding:6px 10px;border:1px solid #E2E8F0'></td>" +
      "<td style='padding:6px 10px;border:1px solid #E2E8F0'></td>" +
      "<td style='padding:6px 10px;border:1px solid #E2E8F0'></td>" +
      "<td style='padding:6px 10px;border:1px solid #E2E8F0'></td>" +
      "<td style='padding:6px 10px;border:1px solid #E2E8F0'></td></tr>"
  )).join("");

  return `
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Asset Declaration - ${n(loan.id)}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800&display=swap');
    @page { size: A4; margin: 5mm; }
    @media print { 
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } 
      .sig-section { margin-top: 10px !important; }
      h2 { margin: 0 0 10px !important; }
      .brand-header { margin-bottom: 10px !important; padding-bottom: 10px !important; }
      .section-title { margin: 10px 0 5px !important; }
      td, th { padding: 4px 8px !important; font-size: 9pt !important; }
    }
    body { 
      font-family: 'Inter', sans-serif; 
      font-size: 10pt; 
      line-height: 1.5; 
      color: #0F172A; 
      margin: 0; 
      padding: 0;
      background: #fff;
      box-sizing: border-box;
    }
    *, *:before, *:after { box-sizing: inherit; }
    
    .brand-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      border-bottom: 3px solid #00D4AA;
      padding-bottom: 15px;
      margin-bottom: 25px;
    }
    .logo-area h1 { 
      font-family: 'Outfit', sans-serif;
      font-size: 22pt; 
      font-weight: 800;
      color: #00D4AA;
      margin: 0;
      text-transform: uppercase;
    }
    .logo-area p { margin: 0; font-size: 9pt; color: #64748B; font-weight: 600; }
    .ref-area { text-align: right; font-size: 9pt; color: #64748B; }

    h2 { 
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      font-size: 14pt; 
      text-align: center; 
      font-weight: 800; 
      margin: 0 0 20px; 
      color: #1E293B;
      text-transform: uppercase;
      letter-spacing: 0px;
      word-spacing: normal;
    }

    .section-title { 
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      font-size: 11pt; 
      font-weight: 800; 
      text-transform: uppercase; 
      color: #00A884;
      background: #F8FAFC;
      padding: 6px 12px; 
      margin: 20px 0 10px; 
      border-left: 4px solid #00D4AA;
      letter-spacing: 0px;
      word-spacing: normal;
    }

    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px; }
    .row { display: flex; gap: 8px; font-size: 9.5pt; margin-bottom: 4px; }
    .lbl { font-weight: 700; color: #475569; min-width: 120px; }
    
    table { width: 100%; border-collapse: collapse; margin: 10px 0; }
    th { background: #F1F5F9; color: #475569; padding: 8px 10px; font-size: 9pt; text-align: left; border: 1px solid #E2E8F0; }
    
    .note-box { background: #F8FAFC; border: 1px dashed #CBD5E1; border-radius: 8px; padding: 10px 15px; min-height: 50px; margin: 10px 0; font-size: 9pt; color: #94A3B8; }
    
    .sig-section { margin-top: 25px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; page-break-inside: avoid; }
    .sig-box { border-top: 2px solid #E2E8F0; padding-top: 10px; }
    .sig-title { font-family: 'Outfit', sans-serif; font-size: 9pt; font-weight: 700; text-transform: uppercase; color: #64748B; margin-bottom: 15px; }
    .sig-img { max-height: 60px; max-width: 100%; object-fit: contain; margin-bottom: -10px; }
    
    .footer { 
      margin-top: 15px; 
      border-top: 1px solid #E2E8F0; 
      padding-top: 15px; 
      font-size: 8pt; 
      text-align: center; 
      color: #94A3B8; 
      page-break-inside: avoid;
    }
  </style>
</head>
<body>
  <div class="brand-header">
    <div class="logo-area">
      
      <img src="${(() => { const p = (loan?.product || 'Swift30'); if (p === 'Swift15') return '/swift15.png'; if (p === 'Flex60' || p === 'Flex 60') return '/flex60.png'; if (p === 'FlexSure') return '/flexsure.png'; return '/swift30.png'; })()}" alt="${n(loan?.product || 'Swift30')}" style="height: 52px; object-fit: contain; display: block; margin-bottom: 4px;" />
      <p>You deserve nothing less!</p>
    </div>
    <div class="ref-area" style="text-align: right;">
      <img src="${ADEQUATE_LOGO_BASE64}" alt="Adequate Capital" style="height: 80px; width: auto; display: block; margin-left: auto; margin-bottom: 8px;" />
      Loan Ref: <b>${n(loan.id)}</b><br>
      Date: <b>${today}</b>
    </div>
  </div>

  <h2>Asset Declaration & Collateral List</h2>

  <div class="section-title">Borrower Details</div>
  <div class="grid">
    <div>
      <div class="row"><span class="lbl">Full Name:</span><span>${n(customer.name)}</span></div>
      <div class="row"><span class="lbl">National ID:</span><span>${n(customer.idNo)}</span></div>
      <div class="row"><span class="lbl">Phone:</span><span>${n(customer.phone)}</span></div>
    </div>
    <div>
      <div class="row"><span class="lbl">Business:</span><span>${n(customer.business)}</span></div>
      <div class="row"><span class="lbl">Location:</span><span>${n(customer.location)}</span></div>
      <div class="row"><span class="lbl">Loan Amount:</span><span><b>${fmtAmt(loan.amount)}</b></span></div>
    </div>
  </div>

  <div class="section-title">Asset List</div>
  <p style="font-size: 9pt; color: #64748B; margin-bottom: 10px;">Please list all assets including household items, business stock, electronics, or vehicles to be used as collateral.</p>
  
  <table>
    <thead>
      <tr>
        <th style="width:5%">#</th>
        <th style="width:35%">Description</th>
        <th style="width:15%">Location</th>
        <th style="width:15%">Est. Value (KES)</th>
        <th style="width:15%">Condition</th>
        <th style="width:15%">Ownership</th>
      </tr>
    </thead>
    <tbody>
      ${rowsHtml}
    </tbody>
  </table>

  <div class="section-title">Additional Notes / Assets</div>
  <div class="note-box">Write any additional items or comments here...</div>
  
  <p style="font-size: 10pt; font-weight: 500; margin: 20px 0;">I, <strong>${n(customer.name)}</strong>, acknowledge that I have signed this asset list that will be used by Adequate Capital to recover their monies in the event of default.</p>

  <div class="sig-section">
    <div class="sig-box">
      <div class="sig-title">Borrower Acceptance</div>
      <div style="height: 40px; border-bottom: 1px dashed #CBD5E1; margin-bottom: 10px; display: flex; align-items: flex-end;">
        ${loan.borrower_signature ? `<img src="${loan.borrower_signature}" class="sig-img" />` : ''}
      </div>
      <div style="font-weight: 700;">${n(customer.name)}</div>
      <div style="font-size: 8pt; color: #64748B;">ID: ${n(customer.idNo)} &nbsp;&middot;&nbsp; Date: ${typeof disbDate !== 'undefined' ? disbDate : today}</div>
    </div>
    <div class="sig-box" style="position: relative;">
      <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-8deg); opacity: 0.85; width: 250px; height: 250px; pointer-events: none; filter: saturate(2.5) contrast(1.8) brightness(0.9);">
        <img src="${ADEQUATE_STAMP_BASE64}" alt="Stamp" style="width: 100%; height: 100%; display: block;" />
        <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; font-family: 'Courier New', Courier, monospace; font-size: 14px; font-weight: 900; color: #dc2626; letter-spacing: 0px; padding-right: 10px; padding-bottom: 2px;">
          ${(() => { const _d = (typeof disbDate !== 'undefined' ? disbDate : today); const _p = _d.split(' '); return _p[0] + ' ' + (_p[1] || '').slice(0, 3).toUpperCase() + ' ' + (_p[2] || ''); })()}
        </div>
      </div>
      <div class="sig-title">For Adequate Capital Ltd</div>

      <div style="height: 40px; border-bottom: 1px dashed #CBD5E1; margin-bottom: 10px; display: flex; align-items: flex-end;">
        ${loan.officer_signature ? `<img src="${loan.officer_signature}" class="sig-img" />` : ''}
      </div>
      <div style="font-weight: 700;">${n(loan.officer || officer || "Donald Barare")}</div>
      <div style="font-size: 8pt; color: #64748B;">Date: ${typeof disbDate !== 'undefined' ? disbDate : today}</div>
    </div>
  </div>

  <div class="footer">
    Adequate Capital Ltd &middot; Micro-Finance &middot; Paybill: 4166191<br>
    T: 0727 625 470 &middot; 0714 256 816
  </div>
</body>
</html>
  `;
};

// Converts a Kenyan phone number (07xx, 01xx, 254xx, 9-digit) to WhatsApp deep-link format (2547xx)
export const normalizePhoneForWhatsApp = (msisdn) => {
  if (!msisdn) return '';
  let phone = String(msisdn).replace(/[\s\-()]/g, '').replace(/^\+/, '');
  if (phone.startsWith('0')) phone = '254' + phone.substring(1);
  else if (phone.length === 9) phone = '254' + phone;
  return phone;
};

export const downloadLoanDoc = (html, filename, format = 'html') => {
  try {
    if (format === 'html' || format === 'pdf') {
      const win = window.open('', '_blank');
      if (win) {
        win.document.open();
        win.document.write(html);
        win.document.close();
        win.setTimeout(() => {
          win.document.title = filename.replace('.html', '.pdf');
          win.print();
        }, 3000);
      } else {
        alert("Please allow popups to generate the PDF document.");
      }
      try { SFX.download(); } catch (e) {}
      return;
    }

    let blob;
    if (format === 'doc') {
      // Use Word-specific blob type for Word export
      blob = new Blob(['\ufeff', html], { type: 'application/msword' });
    } else {
      blob = new Blob([html], { type: "text/html;charset=utf-8" });
    }
    const url = URL.createObjectURL(blob);
    const a = Object.assign(document.createElement("a"), {
      href: url,
      download: filename,
    });
    document.body.appendChild(a);
    a.click();
    setTimeout(() => {
      URL.revokeObjectURL(url);
      document.body.removeChild(a);
    }, 500);
    try {
      SFX.download();
    } catch (e) {}
  } catch (e) {
    console.error("Download failed", e);
  }
};

